# ---------------------------------------------------------------------------
# Ledgerhand environment
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres reached by the application. This user is NOT a superuser and does
# NOT have BYPASSRLS -- row level security is what isolates tenants.
DATABASE_URL=postgres://ledgerhand_app:ledgerhand_app@localhost:5432/ledgerhand

# Migration/owner connection. Only used by `pnpm db:migrate` and `db:seed`.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/ledgerhand

# Sign-in only. This role can SELECT from users and tenants and nothing else,
# because the credential lookup happens before the tenant is known. See
# packages/db/drizzle/0002_auth_lookup_role.sql.
DATABASE_AUTH_URL=postgres://ledgerhand_auth:ledgerhand_auth@localhost:5432/ledgerhand

# Auth.js
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Anthropic API key used by packages/agent and packages/evals.
# The ERP itself never needs it.
ANTHROPIC_API_KEY=

# Agent defaults (per-run guardrails; see packages/agent/src/budget.ts)
AGENT_MODEL=claude-sonnet-5
AGENT_MAX_TOOL_CALLS=25
AGENT_MAX_INPUT_TOKENS=200000
AGENT_MAX_OUTPUT_TOKENS=16000
AGENT_MAX_COST_USD=1.00
AGENT_MAX_WALL_CLOCK_MS=180000

# Demo seed credentials (docker compose / pnpm db:seed)
SEED_PASSWORD=ledgerhand
