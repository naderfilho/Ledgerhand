# ---------------------------------------------------------------------------
# Ledgerhand environment
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# Postgres reached by the application. This user is NOT a superuser and does
# NOT have BYPASSRLS -- row level security is what isolates tenants.
DATABASE_URL=postgres://ledgerhand_app:ledgerhand_app@localhost:5432/ledgerhand

# Migration/owner connection. Only used by `pnpm db:migrate` and `db:seed`.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/ledgerhand

# Sign-in only. This role can SELECT from users and tenants and nothing else,
# because the credential lookup happens before the tenant is known. See
# packages/db/drizzle/0002_auth_lookup_role.sql.
DATABASE_AUTH_URL=postgres://ledgerhand_auth:ledgerhand_auth@localhost:5432/ledgerhand

# Deployment only. The two role passwords above are development defaults and
# they are printed in this repository, which is fine behind a Postgres that
# answers to localhost and unacceptable in front of one whose pooler answers to
# the internet: whoever holds that connection chooses the tenant with
# set_config, so row level security would not slow them down. Set these and
# `pnpm db:migrate` finishes by giving both roles a password nobody can read
# here. At least 16 characters of A-Z a-z 0-9 . _ ~ and -
DATABASE_APP_PASSWORD=
DATABASE_AUTH_PASSWORD=

# Auth.js
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Anthropic API key used by packages/agent and packages/evals.
# The ERP itself never needs it.
ANTHROPIC_API_KEY=

# Agent defaults (per-run guardrails; see packages/agent/src/budget.ts)
AGENT_MODEL=claude-sonnet-5
AGENT_MAX_TOOL_CALLS=25
AGENT_MAX_INPUT_TOKENS=200000
AGENT_MAX_OUTPUT_TOKENS=16000
AGENT_MAX_COST_USD=1.00
AGENT_MAX_WALL_CLOCK_MS=180000

# Demo seed credentials (docker compose / pnpm db:seed)
SEED_PASSWORD=ledgerhand

# ---------------------------------------------------------------------------
# The ERP HTTP API (apps/web), used by the MCP server in its `http` mode.
# Each entry maps a bearer token to a user; the tenant and the role come from
# that user's row, never from the request. A deployment would store hashed
# tokens with an expiry instead of listing them here.
# ---------------------------------------------------------------------------
ERP_API_TOKENS=demo-token:finance@ledgerhand.dev

# ---------------------------------------------------------------------------
# MCP server (packages/mcp-server)
# ---------------------------------------------------------------------------
# `in-process` talks to the database directly (development, eval suite).
# `http` talks to the ERP API above and holds no database credentials.
MCP_GATEWAY=in-process

# in-process: the user the server acts for. Its role decides which tools exist.
MCP_USER_EMAIL=admin@ledgerhand.dev

# http: where the ERP is, and the token to reach it with.
ERP_BASE_URL=http://localhost:3000
ERP_API_TOKEN=demo-token

# elicit  ask a person to confirm destructive operations (default)
# refuse  never perform them
# auto    perform them unattended -- the eval suite only
MCP_APPROVAL=elicit

# Streamable HTTP transport (pnpm --filter @ledgerhand/mcp-server dev:http)
MCP_HTTP_PORT=3333
MCP_HTTP_HOST=127.0.0.1
# Optional shared secret required on the MCP endpoint itself.
MCP_HTTP_TOKEN=

# ---------------------------------------------------------------------------
# Agent (packages/agent)
# ---------------------------------------------------------------------------
# How the agent reaches the ERP. `stdio` launches the MCP server as a child
# process; `http` connects to one already running (pnpm --filter
# @ledgerhand/mcp-server dev:http).
AGENT_ERP=stdio
AGENT_MCP_URL=http://127.0.0.1:3333/mcp

# Thinking depth: low | medium | high | xhigh | max.
AGENT_EFFORT=high
