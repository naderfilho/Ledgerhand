{
  "name": "@ledgerhand/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "ledgerhand-mcp": "./dist/bin/stdio.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/bin/stdio.js",
    "start:http": "node dist/bin/http.js",
    "dev": "tsx src/bin/stdio.ts",
    "dev:http": "tsx src/bin/http.ts"
  },
  "dependencies": {
    "@ledgerhand/db": "workspace:*",
    "@ledgerhand/domain": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@ledgerhand/tsconfig": "workspace:*",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
